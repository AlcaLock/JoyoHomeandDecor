# Copy this file to .env and fill in your values
# Never commit .env to version control

# Server
PORT=3000
FRONTEND_URL="http://localhost:4200"

# Database (Docker default) — single command: docker compose up -d
DATABASE_URL="mysql://joyohyd:change_app_password_before_public_demo@localhost:3306/joyohyd"

# JWT — use a long random string
SECRET_KEY="replace_with_a_long_random_secret_min_40_chars"

# Email (Nodemailer) — used for password reset emails
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_USER="your@email.com"
EMAIL_PASS="replace_with_real_email_app_password"
